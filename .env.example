# OpenAI API key
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o

# ChromaDB persistence directory
CHROMADB_PERSIST_DIR=vector_db

# Server settings
HOST=127.0.0.1
PORT=8000

# MongoDB user profile source (optional).
# When unset, the chatbot runs with generic (non-personalized) context.
MONGODB_URI=
MONGODB_DB_NAME=bookly
MONGODB_USERS_COLLECTION=users

# Optional
LOG_LEVEL=INFO
# Timezone for "today"/"tomorrow" and past-date checks
APP_TIMEZONE=Asia/Dubai
