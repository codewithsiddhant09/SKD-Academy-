# Production Environment Configuration
# Copy this file to .env and configure for your production environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=Bookly AI Appointment Chatbot
APP_ENV=production
APP_PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
# Used for "today"/"tomorrow" and past-date checks
APP_TIMEZONE=Asia/Dubai

# Used for booking slot/date parsing in cancellation policy
# IMPORTANT: Must match your production region
BOOKING_TIMEZONE=Asia/Dubai

# =============================================================================
# OPENAI / AI CONFIGURATION
# =============================================================================
OPENAI_API_KEY=sk-prod-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# BOOKLY BACKEND API
# =============================================================================
BOOKLY_API_TOKEN=your-production-bookly-api-token
CATEGORIES_API_URL=https://bookly.ae:2087/user/allCategories
SALON_INFO_API_URL=https://bookly.ae:2087/user/viewVendor
BOOKING_CREATE_API_URL=https://bookly.ae:2053/booking/createBooking
BOOKING_VIEW_API_URL=https://bookly.ae:2053/booking/viewBooking
BOOKING_CANCELLATION_AMOUNT_API_URL=https://bookly.ae:2053/booking/getCancellationAmount
BOOKING_CANCEL_API_URL=https://bookly.ae:2053/booking/cancelBookingByUser
BOOKING_API_TIMEOUT_SECONDS=15
BOOKING_API_VERIFY_SSL=true
BOOKING_VAT_PERCENTAGE=5.0

# =============================================================================
# WHATSAPP BOOKING INTEGRATION
# =============================================================================
# Secret key for authenticating WhatsApp booking requests
# Generate a strong random string (32+ characters recommended)
WHATSAPP_BOOKING_SECRET=your-production-whatsapp-booking-secret-here

# =============================================================================
# CANCELLATION POLICY
# =============================================================================
# Hours before appointment for free cancellation
FREE_CANCELLATION_HOURS=2

# Flat fee in AED for late cancellation (used if CANCELLATION_FEE_PERCENTAGE is 0)
CANCELLATION_FEE_AED=10

# Percentage fee for late cancellation (if > 0, overrides flat fee)
# Example: 10 for 10% of booking amount
CANCELLATION_FEE_PERCENTAGE=0

# Message for refund processing time (shown to users)
WHATSAPP_REFUND_PROCESSING_TIME=24-48 hours

# =============================================================================
# ZIINA PAYMENT INTEGRATION
# =============================================================================
# Ziina API Configuration
ZIINA_BASE_URL=https://api.ziina.com/v1
ZIINA_API_KEY=your-production-ziina-api-key-here

# Set to false for production (true only for sandbox/testing)
ZIINA_TEST_MODE=false

# Set to false for production (true only for development/testing)
# When true, skips actual Ziina refund API calls
ZIINA_REFUND_MOCK=false

# =============================================================================
# PAYMENT SETTINGS
# =============================================================================
# URL where Ziina redirects after payment completion
# Must be publicly accessible
PAYMENT_RESULT_BASE_URL=https://your-domain.com/payment/paymentResult

# Minutes before unpaid PayNow bookings are automatically cancelled
PAYMENT_HOLD_MINUTES=10

# =============================================================================
# MONGODB DATABASE (Optional)
# =============================================================================
# When configured, enables user profile loading and booking history
# When unset, system runs with in-memory fallback
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=bookly
MONGODB_USERS_COLLECTION=users
MONGODB_ADDRESSES_COLLECTION=addresses
MONGODB_SERVICES_COLLECTION=services
MONGODB_CATEGORIES_COLLECTION=categories
MONGODB_REVIEWS_COLLECTION=reviews

# =============================================================================
# RAG / VECTOR STORE
# =============================================================================
RAG_PERSIST_DIRECTORY=.chroma
RAG_COLLECTION_NAME=bookly_knowledge
TOP_K_RETRIEVAL=8

# =============================================================================
# CACHING
# =============================================================================
CATEGORIES_CACHE_TTL_SECONDS=3600

# =============================================================================
# HTTP CLIENT SETTINGS
# =============================================================================
REQUEST_TIMEOUT_SECONDS=10
VERIFY_SSL=true

# =============================================================================
# NOTIFICATION SERVICES (Optional - Implement as needed)
# =============================================================================
# Firebase Cloud Messaging (FCM) for push notifications
# FCM_SERVER_KEY=your-fcm-server-key
# FCM_SENDER_ID=your-fcm-sender-id

# Email Service (SendGrid, AWS SES, SMTP)
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=your-email-api-key
# EMAIL_FROM_ADDRESS=noreply@bookly.ae
# EMAIL_FROM_NAME=Bookly

# WhatsApp Business API
# WHATSAPP_BUSINESS_API_URL=https://api.whatsapp.com/v1
# WHATSAPP_BUSINESS_API_TOKEN=your-whatsapp-business-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# SMS Service (Twilio, AWS SNS)
# SMS_SERVICE=twilio
# SMS_ACCOUNT_SID=your-twilio-account-sid
# SMS_AUTH_TOKEN=your-twilio-auth-token
# SMS_FROM_NUMBER=+971xxxxxxxxx

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
# Sentry for error tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# PERFORMANCE & SCALING
# =============================================================================
# Number of worker processes (for production deployment)
# WORKERS=4

# Max request size (in bytes)
# MAX_REQUEST_SIZE=10485760

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS allowed origins (comma-separated)
# CORS_ORIGINS=https://bookly.ae,https://app.bookly.ae,https://admin.bookly.ae

# Enable HTTPS redirect
# HTTPS_REDIRECT=true

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
# Enable/disable specific features
# ENABLE_PAYMENT_CRON=true
# ENABLE_BOOKING_REMINDERS=true
# ENABLE_AUTO_CANCELLATION=true
# ENABLE_WHATSAPP_BOOKING=true

# =============================================================================
# ADMIN COMMISSION CONFIGURATION
# =============================================================================
# Admin commission percentage for transactions
ADMIN_COMMISSION_PERCENTAGE=20

# =============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# =============================================================================
#
# 1. SECURITY:
#    - Use strong random values for all secrets
#    - Rotate secrets regularly
#    - Never commit .env to version control
#    - Use environment-specific .env files
#
# 2. ZIINA:
#    - Use production API key (not test key)
#    - Set ZIINA_TEST_MODE=false
#    - Set ZIINA_REFUND_MOCK=false
#    - Test payment flow in sandbox first
#
# 3. TIMEZONE:
#    - Verify BOOKING_TIMEZONE matches your region
#    - Test cancellation policy with correct timezone
#    - Ensure server timezone is UTC for consistency
#
# 4. PAYMENT:
#    - Ensure PAYMENT_RESULT_BASE_URL is publicly accessible
#    - Configure HTTPS for payment result page
#    - Test payment redirect flow
#
# 5. NOTIFICATIONS:
#    - Configure at least one notification channel
#    - Test notification delivery
#    - Set up monitoring for failed notifications
#
# 6. DATABASE:
#    - Configure MongoDB for production
#    - Set up regular backups
#    - Monitor database performance
#
# 7. MONITORING:
#    - Set LOG_LEVEL=INFO or WARNING in production
#    - Configure error tracking (Sentry)
#    - Monitor payment success/failure rates
#    - Track refund processing
#
# 8. CRON JOBS:
#    - Ensure BookingCronService starts on app startup
#    - Monitor cron job execution
#    - Track payment timeout cancellations
#
# 9. TESTING:
#    - Test all workflows in staging first
#    - Verify Ziina integration works
#    - Test refund process
#    - Verify notification delivery
#
# 10. BACKUP:
#     - Keep backup of working .env
#     - Document all configuration changes
#     - Have rollback plan ready
#
# =============================================================================
