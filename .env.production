# ============================================================================
# BOOKLY AI AGENT - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to /var/www/a-agent-base/.env on your production server
# Replace placeholder values marked with [REQUIRED] or [OPTIONAL]
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS (Required)
# ============================================================================
APP_NAME=Bookly AI Appointment Chatbot
APP_ENV=production
APP_PORT=8000

# Timezone Configuration
APP_TIMEZONE=Asia/Dubai
BOOKING_TIMEZONE=Asia/Dubai

# ============================================================================
# OPENAI API (Required)
# ============================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# BOOKLY BACKEND API (Required)
# ============================================================================
CATEGORIES_API_URL=https://admin.bookly.ae:2053/user/allCategories
SALON_INFO_API_URL=https://admin.bookly.ae:2053/user/viewVendor

# ============================================================================
# BOOKLY BOOKING API (Required)
# ============================================================================
BOOKING_CREATE_API_URL=http://15.252.235.83:2053/booking/createBooking
BOOKING_VIEW_API_URL=http://15.252.235.83:2053/booking/viewBooking
BOOKING_CANCELLATION_AMOUNT_API_URL=http://15.252.235.83:2053/booking/getCancellationAmount
BOOKING_CANCEL_API_URL=http://15.252.235.83:2053/booking/cancelBookingByUser
BOOKING_API_TIMEOUT_SECONDS=15
BOOKING_API_VERIFY_SSL=true
BOOKING_VAT_PERCENTAGE=5.0

# Authentication Token (Optional - uses user's token from frontend)
# Only needed as fallback for guest bookings
BOOKLY_API_TOKEN=

# ============================================================================
# WHATSAPP INTEGRATION (Required for WhatsApp bookings)
# ============================================================================
WHATSAPP_BOOKING_SECRET=e5255a245ae3830a98aeeb49e3c01a8e0b5d77707c5574752e6a0aa9484a2ca6

# ============================================================================
# MONGODB DATABASE (Required)
# ============================================================================
MONGODB_URI=mongodb+srv://diyaagrawal:t3CWMajMKvlR9svb@cluster0.hqads.mongodb.net/bookly
MONGODB_DB_NAME=bookly_staging
MONGODB_USERS_COLLECTION=users
MONGODB_ADDRESSES_COLLECTION=addresses
MONGODB_SERVICES_COLLECTION=services
MONGODB_CATEGORIES_COLLECTION=categories
MONGODB_REVIEWS_COLLECTION=reviews

# Aliases (for backward compatibility)
MONGO_URI=mongodb+srv://diyaagrawal:t3CWMajMKvlR9svb@cluster0.hqads.mongodb.net/bookly
MONGO_DB_NAME=bookly_staging

# ============================================================================
# ZIINA PAYMENT INTEGRATION (Optional - for PayNow bookings)
# ============================================================================
# Get production API key from: https://dashboard.ziina.com
ZIINA_BASE_URL=https://api.ziina.com/v1

# [OPTIONAL] Add your Ziina production API key here
# Get from: https://dashboard.ziina.com → API Settings
ZIINA_API_KEY=

# Test mode settings (set to false for production when you have API key)
ZIINA_TEST_MODE=true
ZIINA_REFUND_MOCK=true

# ============================================================================
# PAYMENT CONFIGURATION (Required for PayNow bookings)
# ============================================================================
# Update this to your production domain after deployment
PAYMENT_RESULT_BASE_URL=http://103.225.186.22:8000/payment/paymentResult

# Minutes to hold unpaid PayNow bookings before auto-cancellation
PAYMENT_HOLD_MINUTES=10

# Message shown to users about refund processing time
WHATSAPP_REFUND_PROCESSING_TIME=24-48 hours

# ============================================================================
# CANCELLATION POLICY (Required)
# ============================================================================
# Hours before appointment for free cancellation (e.g., 2.0 = 2 hours)
FREE_CANCELLATION_HOURS=2.0

# Flat cancellation fee in AED (used if CANCELLATION_FEE_PERCENTAGE is 0)
CANCELLATION_FEE_AED=10.0

# Percentage-based fee (if > 0, overrides flat fee)
# Example: 10.0 = 10% of booking amount
CANCELLATION_FEE_PERCENTAGE=0.0

# ============================================================================
# RAG / VECTOR STORE (Optional - for knowledge base)
# ============================================================================
RAG_PERSIST_DIRECTORY=.chroma
RAG_COLLECTION_NAME=bookly_knowledge
TOP_K_RETRIEVAL=8

# Legacy settings (for backward compatibility)
CHROMADB_PERSIST_DIR=chroma_db

# ============================================================================
# HTTP CLIENT SETTINGS (Optional)
# ============================================================================
CATEGORIES_CACHE_TTL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=10
VERIFY_SSL=true

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
#
# REQUIRED STEPS:
# ---------------
# 1. ✅ OPENAI_API_KEY - Already set
# 2. ✅ WHATSAPP_BOOKING_SECRET - Already set
# 3. ✅ MONGODB_URI - Already set
# 4. ✅ All Booking API URLs - Already set
#
# OPTIONAL (Add when ready):
# --------------------------
# 5. ⚠️ ZIINA_API_KEY - Get from https://dashboard.ziina.com
#    Without this: PayNow bookings will use mock mode
# 
# 6. ⚠️ BOOKLY_API_TOKEN - Only if needed for guest bookings
#    Without this: Uses user's login token (works fine)
#
# 7. ⚠️ PAYMENT_RESULT_BASE_URL - Update to your domain
#    Current: Uses IP address (works but not ideal)
#
# DEPLOYMENT COMMAND:
# ------------------
# Copy to production:
#   scp .env.production ubuntu@172.31.32.142:/var/www/a-agent-base/.env
#
# Then on server:
#   cd /var/www/a-agent-base
#   pm2 restart agentserver
#
# ============================================================================
